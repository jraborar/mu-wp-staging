# Supabase — copy to .env.local and fill in your values
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pantheon Terminus machine token — required for all terminus commands
# Generate at: https://dashboard.pantheon.io/personal-settings/machine-tokens
TERMINUS_TOKEN=

# Pantheon SSH private key (single line, \n for newlines) — optional
# Required only for upstream conflict auto-revert via git push
# Add the matching public key at: https://dashboard.pantheon.io/personal-settings/ssh-keys
PANTHEON_SSH_KEY=

# Port the Next.js server listens on (Railway sets this automatically)
PORT=3000

# mu-deployment app — auto-schedule a deployment after successful staging
# Set to the Railway URL of your mu-deployment instance
MU_DEPLOY_URL=https://your-mu-deployment.up.railway.app
# Deployment pipeline destination (default: live — runs multidev → dev → test → live)
MU_DEPLOY_DESTINATION=live
# Business days after today to schedule the deployment (default: 2)
MU_DEPLOY_SCHEDULE_DAYS=2
