node_modules/
.env.local
*.pem

# TypeScript incremental build cache — regenerated by every build, and it
# conflicted on every parallel PR merge (#151 vs #153).
tsconfig.tsbuildinfo

# Local-only working docs (PR proposals, design scratchpads, test-site notes).
# These are a local scratchpad and are NEVER committed — ship.sh's `git add -A`
# honors this ignore. When a doc's PR merges, backfill its real PR number into
# the local copy. (docs already committed on pr-0085/#167 must be `git rm`'d in a
# follow-up — a gitignore entry does not untrack already-tracked files.)
docs/
