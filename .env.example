# ── Supabase ──────────────────────────────────────────────────────────────
# Shared project with mu-deployment + mu_multidev_create
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key            # auth (login/signup/OAuth)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key         # background staging jobs + history

# ── Auth ──────────────────────────────────────────────────────────────────
# Used for OAuth redirect fallback + email password-reset links.
# On Railway, RAILWAY_PUBLIC_DOMAIN is auto-set and preferred for OAuth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Terminus / Pantheon ─────────────────────────────────────────────────────
TERMINUS_TOKEN=your-pantheon-machine-token
PANTHEON_SSH_KEY=base64-encoded-private-key             # required for terminus wp (WP-CLI)

# ── Integrations (optional) ─────────────────────────────────────────────────
MU_DEPLOY_URL=https://your-mu-deployment.up.railway.app # auto-schedule deployments
MU_DEPLOY_DESTINATION=live
MU_DEPLOY_SCHEDULE_DAYS=1
